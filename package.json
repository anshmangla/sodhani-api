{
  "name": "sodhani-api",
  "version": "1.0.0",
  "description": "Read-only REST API over the sodhaniScrap market-data PostgreSQL database (top gainers/losers, volume shockers, quotes, history, announcements).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "seed:ra": "ts-node scripts/seed-research-analysts.ts",
    "seed:calls": "ts-node scripts/seed-sample-data.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "razorpay": "^2.9.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
